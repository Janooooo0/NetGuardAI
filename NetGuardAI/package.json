{
  "name": "netguard-ai-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm:server\" \"vite --host 127.0.0.1\"",
    "dev:web": "vite --host 127.0.0.1",
    "server": "python3 backend/server.py",
    "test:api": "python3 -m unittest backend.test_server",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
